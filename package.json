    "http-status-codes": "2.3.0",
    "jest-util": "^30.2.0",
    "mongoose": "^9.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2"
